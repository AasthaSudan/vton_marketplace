# Local Clothsy backend (docker compose). Copy to supabase/.env:
#   cp supabase/.env.example supabase/.env
# Every value here is a PUBLIC DEMO value from Supabase's self-hosting guide,
# safe only on your own machine. Never reuse them for a hosted project.

POSTGRES_PASSWORD=clothsy-local-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# HS256 secret and the demo anon / service_role keys signed with it
# (valid until 2027-01-10; regenerate with any JWT tool if they expire).
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# What the app calls (gateway) and where auth links point.
API_EXTERNAL_URL=http://127.0.0.1:54321
SITE_URL=http://localhost:3000

# Phone sign-in without an SMS provider: these numbers always accept the
# given code and never send a real SMS (format: <e164 without +>:<code>).
SMS_TEST_OTP=919999900001:123456,919999900002:123456,919999900003:123456

# Providers. Leave keys empty to use the local mock providers; mocks are
# only allowed while ALLOW_MOCK_PROVIDERS=true (never set it in production).
ALLOW_MOCK_PROVIDERS=true
MOCK_WEBHOOK_SECRET=clothsy-local-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Seller payouts (RazorpayX): keys and the business account money is sent from.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
FABRICVTON_API_URL=
FABRICVTON_API_KEY=
MOCK_TRYON_PENDING_POLLS=2
